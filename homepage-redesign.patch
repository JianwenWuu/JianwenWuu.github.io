+/* ------------------------------------------------------------
+   Jianwen Wu — academic homepage
+   Palette and details follow the Loro Piana homepage:
+   ivory ground, brick red accent, red/rose double stripe,
+   serif titles, humanist-sans navigation, "– link –" style.
+   Fonts are self-hosted via next/font/local (app/layout.tsx),
+   so the page also renders correctly where Google Fonts is blocked.
+   ------------------------------------------------------------ */
+
+:root {
+  color-scheme: light; /* one visual world: ivory, also under a dark OS theme */
+  --bg: #f7f5f1; /* ivory page */
+  --bar: #eeeae5; /* top bar, panels, footer */
+  --ink: #121010; /* headings, nav */
+  --text: #2e2926; /* body copy */
+  --muted: #6f665f; /* dates, meta (AA on both grounds) */
+  --line: #ded7cf; /* hairlines */
+  --red: #9d5248; /* brick red accent */
+  --rose: #c3b0a5; /* stripe middle band, underlines */
+
+  --serif:
+    var(--font-newsreader), 'Iowan Old Style', 'Palatino Linotype', Palatino,
+    Georgia, serif;
+  --sans: var(--font-tenor), Optima, Candara, 'Segoe UI', sans-serif;
 
+  --wrap: 1120px;
+  --gutter: clamp(20px, 5vw, 56px);
+}
+
+/* ---------- Base ---------- */
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+  scroll-behavior: smooth;
+}
+@media (prefers-reduced-motion: reduce) {
   html {
-    @apply scroll-smooth bg-background font-sans;
-    scroll-padding-top: 5rem;
+    scroll-behavior: auto;
   }
-
-  body {
-    @apply bg-background text-foreground;
-    min-width: 320px;
-    font-size: 16px;
-    font-family: 'Geist', 'Inter', 'Helvetica Neue', Arial, sans-serif;
-    -webkit-font-smoothing: antialiased;
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
   }
+}
 
-  ::selection {
-    background: #76b900;
-    color: #000000;
-  }
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font-family: var(--serif);
+  font-size: 18px;
+  line-height: 1.7;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+  text-rendering: optimizeLegibility;
+}
 
-  a,
-  button {
-    -webkit-tap-highlight-color: transparent;
-  }
+strong,
+b {
+  font-weight: 600;
+}
 
-  :focus-visible {
-    outline: 2px solid #76b900;
-    outline-offset: 4px;
-  }
+img {
+  display: block;
+  max-width: 100%;
+  height: auto;
+}
+p {
+  margin: 0;
+}
+h1,
+h2,
+h3 {
+  margin: 0;
+  font-weight: 500;
+  color: var(--ink);
+  text-wrap: balance;
+}
+ul,
+ol {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+figure {
+  margin: 0;
+}
+::selection {
+  background: var(--rose);
+  color: var(--ink);
 }
 
-@layer utilities {
-  .site-container {
-    width: min(100% - 3rem, 87.5rem);
-    margin-inline: auto;
-  }
+a {
+  color: inherit;
+  text-decoration-line: underline;
+  text-decoration-thickness: 1px;
+  text-decoration-color: var(--rose);
+  text-underline-offset: 0.22em;
+  transition:
+    color 0.2s ease,
